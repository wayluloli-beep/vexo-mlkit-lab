+package com.trackingracing
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class SlotCenaOcrTest {
+    @Test fun primeiraCopiaSomenteMesmoDepoisDeDrenar() {
+        val s=SlotCenaOcr<String>()
+        assertTrue(s.aceitaCopia(5))
+        assertTrue(s.guardar(5,"A").aceita)
+        assertFalse(s.aceitaCopia(5))
+        assertFalse(s.guardar(5,"duplicata").aceita)
+        assertEquals("A",s.retirar()?.quadro)
+        assertNull(s.retirar())
+        assertFalse(s.aceitaCopia(5))
+        assertFalse(s.aceitaCopia(3))
+        assertTrue(s.aceitaCopia(6))
+    }
+
+    @Test fun novaEpocaSubstituiApenasUmItem() {
+        val s=SlotCenaOcr<String>()
+        assertTrue(s.guardar(10,"A").aceita)
+        val novo=s.guardar(12,"B")
+        assertTrue(novo.aceita)
+        assertEquals(SlotCenaOcr.Item(10L,"A"),novo.substituido)
+        assertEquals(12L,s.epocaPendente())
+        assertEquals(SlotCenaOcr.Item(12L,"B"),s.retirar())
+        assertNull(s.retirar())
+    }
+
+    @Test fun pararEntregaRecursoUmaVezEBloqueiaCopiaConcorrente() {
+        val s=SlotCenaOcr<String>()
+        assertTrue(s.guardar(1,"A").aceita)
+        assertTrue(s.aceitaCopia(2))
+        assertEquals("A",s.fechar()?.quadro)
+        assertFalse(s.guardar(2,"B").aceita)
+        assertFalse(s.aceitaCopia(3))
+        assertNull(s.retirar())
+        assertNull(s.fechar())
+    }
+
+    @Test fun pausaRetiraSemReabrirEpocaAntiga() {
+        val s=SlotCenaOcr<String>()
+        assertTrue(s.guardar(2,"A").aceita)
+        assertEquals("A",s.retirar()?.quadro)
+        assertFalse(s.guardar(2,"A").aceita)
+        assertTrue(s.guardar(3,"B").aceita)
+    }
+
+    @Test fun fundoUniformeOuRuidoEsparsoNaoRecebemReserva() {
+        val neutro=IntArray(1152){0xff4444}
+        assertFalse(SlotCenaOcr.temEstrutura(neutro))
+        neutro[2]=0x000000
+        neutro[3]=0xffffff
+        assertFalse(SlotCenaOcr.temEstrutura(neutro))
+        assertFalse(SlotCenaOcr.temEstrutura(IntArray(1152){-1}))
+    }
+
+    @Test fun cenaEstruturadaComMascaraSuficientePodeReceberReserva() {
+        assertTrue(SlotCenaOcr.temEstrutura(IntArray(1152){ i ->
+            when {
+                i<400 -> -1
+                i<800 -> 0x222222
+                else -> 0xdddddd
+            }
+        }))
+    }
+}
