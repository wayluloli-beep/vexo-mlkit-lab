+package com.trackingracing
+
+/** One owned frame, reserved by the capture thread; stop may close it from UI. */
+internal class SlotCenaOcr<T : Any> {
+    data class Item<T>(val epoca: Long, val quadro: T)
+    data class Entrada<T>(val aceita: Boolean, val substituido: Item<T>?)
+    private var item: Item<T>? = null
+    private var ultimaEpocaCopiada: Long? = null
+    private var fechado = false
+
+    @Synchronized fun aceitaCopia(epoca: Long): Boolean =
+        !fechado && (ultimaEpocaCopiada?.let { epoca > it } ?: true)
+
+    /** The caller keeps the new item on rejection and releases every detached item. */
+    @Synchronized fun guardar(epoca: Long, quadro: T): Entrada<T> {
+        if (!aceitaCopia(epoca)) return Entrada(false, null)
+        val anterior = item
+        item = Item(epoca, quadro)
+        ultimaEpocaCopiada = epoca
+        return Entrada(true, anterior)
+    }
+
+    @Synchronized fun epocaPendente(): Long? = item?.epoca
+
+    @Synchronized fun retirar(): Item<T>? = item.also { item = null }
+
+    @Synchronized fun fechar(): Item<T>? {
+        fechado = true
+        return item.also { item = null }
+    }
+
+    companion object {
+        /** Excludes visibly flat frames from the reserve, not an offer classifier. */
+        fun temEstrutura(amostra: IntArray): Boolean {
+            val faixas = IntArray(16)
+            var validos = 0
+            for (rgb in amostra) {
+                if (rgb < 0) continue
+                val r = rgb shr 16 and 255
+                val g = rgb shr 8 and 255
+                val b = rgb and 255
+                faixas[(r * 54 + g * 183 + b * 19) shr 12]++
+                validos++
+            }
+            if (validos == 0 || validos * 3 < amostra.size) return false
+            val minimo = maxOf(4, (validos + 99) / 100)
+            val baixa = faixas.indexOfFirst { it >= minimo }
+            val alta = faixas.indexOfLast { it >= minimo }
+            return baixa >= 0 && alta - baixa >= 2
+        }
+    }
+}
