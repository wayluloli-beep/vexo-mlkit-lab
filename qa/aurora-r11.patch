+package com.trackingracing
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class FaixaUniformeOCRTest {
+    @Test fun removeApenasFaixaVaziaNaTelaVertical() {
+        val intervalo=FaixaUniformeOCR.margens(720,1280)!!
+        assertEquals(460,intervalo.inicio)
+        assertEquals(652,intervalo.fim)
+        assertTrue(FaixaUniformeOCR.confirmar(720,intervalo){ _,row -> row.fill(0xffdde3e3.toInt()) })
+    }
+
+    @Test fun UmPixelPodeSerTextoNaoRemoveFaixa() {
+        val f=FaixaUniformeOCR.margens(720,1280)!!
+        assertFalse(FaixaUniformeOCR.confirmar(720,f){ y,row ->
+            row.fill(0xffdde3e3.toInt())
+            if(y==f.fim-1) row[719]=0xffdde3e2.toInt()
+        })
+    }
+
+    @Test fun SemAmostraOuPaisagemMantemImagem() {
+        assertNull(FaixaUniformeOCR.margens(1280,720))
+        assertNull(FaixaUniformeOCR.margens(0,0))
+    }
+}
