+        c.drawBitmap(orig,Rect(0,0,w,f.inicio),Rect(0,0,w,f.inicio),null)
+        c.drawBitmap(orig,Rect(0,f.fim,w,h),Rect(0,f.inicio,w,novo.height),null)
+        return novo
     }
 
