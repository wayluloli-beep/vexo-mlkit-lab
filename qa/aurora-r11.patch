+package com.trackingracing
+
+/** Limits optimization to a pixel-exact empty band. Keep the original when uncertain. */
+internal object FaixaUniformeOCR {
+    data class Faixa(val inicio:Int,val fim:Int)
+    fun margens(w:Int,h:Int):Faixa? {
+        if(w<300 || h<600 || w>=h) return null
+        return Faixa((h*.36).toInt(),(h*.51).toInt())
+    }
+    fun confirmar(w:Int,f:Faixa,linha:(Int,IntArray)->Unit):Boolean {
+        if(w<=0 || f.inicio<0 || f.fim<=f.inicio)return false
+        val row=IntArray(w)
+        linha(f.inicio,row)
+        val c=row[0]
+        // An all-black band may be a protection mask. Don't crop it.
+        if ((c and 0x00ffffff)==0 || row.any{it!=c}) return false
+        for(y in f.inicio+1 until f.fim) {
+            linha(y,row)
+            if(row.any{it!=c})return false
+        }
+        return true
+    }
+}
