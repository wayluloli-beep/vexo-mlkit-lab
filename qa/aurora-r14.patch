+package com.trackingracing
+
+/** Synchronized because selection comes from the WebView bridge, not the UI thread. */
+internal class AuroraLocalOfferPixels {
+    class Selection internal constructor(val token: String?)
+    class Frame internal constructor(val token: String, val pixelCopy: Boolean)
+    private val tokenPattern = Regex("[0-9]{1,18}-[0-9]{1,6}")
+    private var selection: Selection? = null
+    private var committedFrame: Frame? = null
+
+    @Synchronized fun select(raw: String): Selection? {
+        val token = raw.takeIf { tokenPattern.matches(it) }
+        if (selection?.token == token) return null
+        val update = Selection(token)
+        selection = update
+        committedFrame = null
+        return update
+    }
+
+    @Synchronized fun selected(): Selection? = selection?.takeIf { it.token != null }
+    @Synchronized fun isSelected(stamp: Selection): Boolean = stamp === selection
+    @Synchronized fun pause() { committedFrame = null }
+
+    @Synchronized fun markFrame(stamp: Selection, pixelCopy: Boolean) {
+        val token = stamp.token ?: return
+        if (stamp === selection) committedFrame = Frame(token, pixelCopy)
+    }
+
+    @Synchronized fun frame(): Frame? = committedFrame
+    @Synchronized fun isCurrent(frame: Frame): Boolean = frame === committedFrame
+}
