+package com.trackingracing
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class AuroraLocalOfferPixelsTest {
+    private val gate = AuroraLocalOfferPixels()
+    @Test fun selectedCardIsNotCapturableUntilAFrameIsReady() {
+        val a = gate.select("1760000000000-1")!!
+        assertNull(gate.frame())
+        gate.markFrame(a, true)
+        assertTrue(gate.frame()!!.pixelCopy)
+        assertEquals("1760000000000-1", gate.frame()!!.token)
+    }
+    @Test fun lateCommitAndLateOcrCannotRetargetNextCard() {
+        val a = gate.select("1760000000000-1")!!
+        gate.markFrame(a, true)
+        val frameA = gate.frame()!!
+        val b = gate.select("1760000000000-3")!!
+        assertFalse(gate.isCurrent(frameA))
+        gate.markFrame(a, true)
+        assertNull(gate.frame())
+        gate.markFrame(b, true)
+        assertTrue(gate.isCurrent(gate.frame()!!))
+        assertFalse(gate.isCurrent(frameA))
+    }
+    @Test fun revisitingSameCardLabelDoesNotRevivePreviousFrame() {
+        val a = gate.select("1760000000000-1")!!
+        gate.markFrame(a, true)
+        val old = gate.frame()!!
+        gate.select("")
+        val repeated = gate.select("1760000000000-1")!!
+        assertFalse(gate.isCurrent(old))
+        gate.markFrame(a, true)
+        assertNull(gate.frame())
+        gate.markFrame(repeated, false)
+        assertFalse(gate.frame()!!.pixelCopy)
+        assertFalse(gate.isCurrent(old))
+    }
+    @Test fun visibilityPauseInvalidatesInFlightFrame() {
+        val a = gate.select("1760000000000-1")!!
+        gate.markFrame(a, true)
+        val old = gate.frame()!!
+        gate.pause()
+        assertFalse(gate.isCurrent(old))
+        assertNull(gate.frame())
+        assertSame(a, gate.selected())
+    }
+    @Test fun malformedOrUntaggedCardNeverProducesFrame() {
+        assertNull(gate.select("address-not-an-id"))
+        val a = gate.select("1760000000000-1")!!
+        gate.markFrame(a, true)
+        val old = gate.frame()!!
+        gate.select("malformed")
+        assertFalse(gate.isCurrent(old))
+        assertNull(gate.selected())
+    }
+}
