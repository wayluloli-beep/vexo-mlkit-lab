+    // Pre-OCR, 1,152 points, in the lower central screen, before copying a full RGBA frame.
+    // The overlay bounds are treated as unknown on both sides of comparisons.
+    private fun amostrarCena(imagem:Image,caixa:CaixaPainel):IntArray? {
+        val plano=imagem.planes.firstOrNull() ?: return null
+        val buffer=plano.buffer
+        val w=imagem.width;val h=imagem.height
+        if (w<=0 || h<=0 || plano.pixelStride<3) return null
+        val resultado=IntArray(32*36){-1}
+        for (linha in 0 until 36) for (coluna in 0 until 32) {
+            val x=(w*(.08+(.84*(coluna+.5)/32))).toInt()
+            val y=(h*(.53+(.42*(linha+.5)/36))).toInt()
+            if (x in caixa.esquerda until caixa.direita && y in caixa.topo until caixa.fundo) continue
+            val at=buffer.position()+y*plano.rowStride+x*plano.pixelStride
+            if (at<0 || at+2>=buffer.limit()) continue
+            resultado[linha*32+coluna]=((buffer.get(at).toInt() and 255) shl 16) or
+                ((buffer.get(at+1).toInt() and 255) shl 8) or (buffer.get(at+2).toInt() and 255)
+        }
+        return resultado
