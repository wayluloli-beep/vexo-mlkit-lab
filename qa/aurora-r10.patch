+package com.trackingracing
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class FrescorCenaPainelTest {
+    private fun cor(c:Int) = IntArray(32 * 36){c}
+    @Test fun callbackDaOfertaAnteriorNaoAtravessaRetirada() {
+        val g=FrescorCenaPainel()
+        val b=g.observar(cor(0x101010),1L,100L).bilhete!!
+        val suspeita=g.observar(cor(0xf0f0f0),2L,350L)
+        assertNull(suspeita.bilhete)
+        assertFalse(suspeita.limpar)
+        assertFalse(g.valido(b,400L))
+        val n=g.observar(cor(0xf0f0f0),3L,600L)
+        assertTrue(n.limpar)
+        assertNotNull(n.bilhete)
+        assertFalse(g.valido(b,700L))
+    }
+    @Test fun quadroEquivalenteNaoCancelaOCRQueDemora() {
+        val g=FrescorCenaPainel()
+        val a=g.observar(cor(0x202020),1L,100L).bilhete!!
+        for (i in 2..20) assertFalse(g.observar(cor(0x222222),i.toLong(),100L+i*250L).limpar)
+        assertTrue(g.valido(a,5200L))
+        assertFalse(g.valido(a,13000L))
+    }
+    @Test fun oscilacaoUnicaPreservaOfertaMasInvalidaCallbackEmVoo() {
+        val g=FrescorCenaPainel()
+        val a=g.observar(cor(0x101010),1L,100L).bilhete!!
+        assertFalse(g.observar(cor(0xc0c0c0),2L,350L).limpar)
+        val volta=g.observar(cor(0x101010),3L,600L)
+        assertFalse(volta.limpar)
+        assertNotNull(volta.bilhete)
+        assertFalse(g.valido(a,630L))
+        assertTrue(g.valido(volta.bilhete!!,650L))
+    }
+    @Test fun primeiroErroNaoPiscaSegundoErroLimpa() {
+        val g=FrescorCenaPainel()
+        val a=g.observar(cor(0x101010),1L,100L).bilhete!!
+        g.acerto(a)
+        assertFalse(g.falha(a))
+        assertTrue(g.falha(g.observar(cor(0x101010),2L,330L).bilhete!!))
+    }
+    @Test fun timestampDuplicadoNaoContaComoSegundaObservacao() {
+        val g=FrescorCenaPainel()
+        g.observar(cor(0x101010),1L,100L)
+        g.observar(cor(0xf0f0f0),2L,330L)
+        assertFalse(g.observar(cor(0xf0f0f0),2L,550L).limpar)
+        assertTrue(g.observar(cor(0xf0f0f0),3L,800L).limpar)
+    }
+    @Test fun mascaraDoBalaoNaoGeraMudanca() {
+        val g=FrescorCenaPainel()
+        val a=cor(0x101010).also { for (i in 0..300) it[i]=-1 }
+        val b=cor(0x101010).also { for (i in 400..700) it[i]=-1 }
+        val ticket=g.observar(a,1L,100L).bilhete!!
+        assertFalse(g.observar(b,2L,350L).limpar)
+        assertTrue(g.valido(ticket,365L))
+    }
+}
