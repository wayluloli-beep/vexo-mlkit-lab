+package com.trackingracing
+
+/** The frame producer and ML Kit completion can be on different threads. Work only with
+ * comparable visual pixels and a stable scene; a newer buffer by itself is not a new card. */
+internal class FrescorCenaPainel {
+    class Bilhete(val epoca:Long, val capturadoEm:Long, val frame:Long)
+    class Observacao(val bilhete:Bilhete?, val limpar:Boolean, val motivo:String)
+    private var epoca=0L
+    private var ultimoFrame=0L
+    private var base:IntArray?=null
+    private var candidata:IntArray?=null
+    private var falhas=0
+
+    private fun distancia(a:IntArray,b:IntArray):Double? {
+        if (a.size!=b.size) return null
+        var total=0
+        var passou=0
+        for (i in a.indices) {
+            val x=a[i];val y=b[i]
+            if (x<0 || y<0) continue
+            total++
+            val r=kotlin.math.abs((x shr 16 and 255) - (y shr 16 and 255))
+            val g=kotlin.math.abs((x shr 8 and 255) - (y shr 8 and 255))
+            val bl=kotlin.math.abs((x and 255) - (y and 255))
+            if (r+g+bl>65) passou++
+        }
+        return if(total*3<a.size || total==0) null else passou.toDouble()/total
+    }
+
+    @Synchronized fun reiniciar() {
+        epoca++; ultimoFrame=0L; base=null; candidata=null; falhas=0
+    }
+
+    @Synchronized fun observar(pixels:IntArray,frame:Long,agora:Long):Observacao {
+        if(frame>0 && frame<=ultimoFrame) return Observacao(null,false,"duplicado")
+        if(frame>0) ultimoFrame=frame
+        val anterior=base
+        if(anterior==null) {
+            if(pixels.count{it>=0}*3<pixels.size) return Observacao(null,false,"sem_amostra")
+            base=pixels
+            return Observacao(Bilhete(epoca,agora,frame),false,"primeiro")
+        }
+        val diferenca=distancia(anterior,pixels) ?: return Observacao(null,false,"sem_amostra")
+        if(diferenca<=.28) {
+            val retomada=candidata!=null
+            candidata=null
+            return Observacao(Bilhete(epoca,agora,frame),false,if(retomada) "retomada" else "estavel")
+        }
+        val outra=candidata
+        if(outra==null) {
+            epoca++; candidata=pixels
+            return Observacao(null,false,"mudanca_suspeita")
+        }
+        val concorda=distancia(outra,pixels)
+        if(concorda==null || concorda>.20) {
+            candidata=pixels
+            return Observacao(null,false,"mudando")
+        }
+        epoca++; base=pixels; candidata=null; falhas=0
+        return Observacao(Bilhete(epoca,agora,frame),true,"mudanca_confirmada")
+    }
+
+    @Synchronized fun valido(bilhete:Bilhete,agora:Long):Boolean =
+        bilhete.epoca==epoca && candidata==null && agora-bilhete.capturadoEm in 0..12_000L
+
+    @Synchronized fun acerto(bilhete:Bilhete) {
+        if(bilhete.epoca==epoca && candidata==null) falhas=0
+    }
+
+    @Synchronized fun falha(bilhete:Bilhete):Boolean {
+        if(bilhete.epoca!=epoca || candidata!=null) return false
+        falhas=(falhas+1).coerceAtMost(2)
+        return falhas>=2
+    }
+}
